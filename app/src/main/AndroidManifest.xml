<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PortfolioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AliAbdulrazzakPortfolio"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AliAbdulrazzakPortfolio.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".hamburgertracker.HamburgerTrackerActivity"
            android:exported="false"
            android:label="Hamburger Tracker" />
        <activity
            android:name=".diceroller.DiceRollerActivity"
            android:exported="false"
            android:label="Dice Roller" />
        <activity
            android:name=".unscramble.UnscrambleActivity"
            android:exported="false"
            android:label="Unscramble" />
        <activity
            android:name=".waterme.WaterMeActivity"
            android:exported="false"
            android:label="Water Me" />
    </application>

</manifest>